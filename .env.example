# GEMINI_API_KEY: Optional Gemini API key for AI-assisted features.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_API_BASE_URL: Frontend API base path. Defaults to /api for local proxy use.
VITE_API_BASE_URL="/api"

# SENDIE_AUTH_SECRET: Session signing secret for the backend API.
SENDIE_AUTH_SECRET="change-me-in-development"

# SENDIE_RESET_SECRET: Optional admin-only reset key for demo data refresh.
SENDIE_RESET_SECRET="change-me-reset"

# DIRECT_URL: Direct PostgreSQL connection string used by Prisma CLI.
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/sendie"

# DATABASE_URL: Pooled PostgreSQL connection string used by the runtime.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/sendie"

# PORT: Backend API port when running `npm run dev:api`.
PORT="4000"

# APP_URL: The URL where this app is hosted.
APP_URL="MY_APP_URL"

# PAYSTACK_SECRET_KEY: Server-side secret key for hosted checkout and verification.
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxx"

# SENDIE_PAYMENT_PROVIDER: Payment provider selector. Defaults to flutterwave.
SENDIE_PAYMENT_PROVIDER="paystack"
